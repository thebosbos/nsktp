# MongoDB Atlas connection string. Replace <db_password> with the real password
# for the boussaadam7_db_user user, and add a database name before the "?".
MONGODB_URI=mongodb+srv://boussaadam7_db_user:<db_password>@cluster0.hqdzxfu.mongodb.net/nsktp?retryWrites=true&w=majority&appName=Cluster0

# Random 32+ byte secret used to sign admin session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Used once by `npm run seed` to create the first admin account. Not needed after that.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@nsktp.dz
SEED_ADMIN_PASSWORD=change-me-please
